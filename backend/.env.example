# ═══════════════════════════════════════════════
#  LaLlamaOllama — Backend (Express + Ollama)
#  Copia este archivo a .env y rellena los valores
# ═══════════════════════════════════════════════

# Master Key para autenticación (Requerida)
# Usada por el frontend, clientes MCP y endpoints compatibles con OpenAI
API_KEY=YOUR_SECURE_API_KEY_HERE

# Puerto donde correrá el servidor (Default: 3000 / Docker: 3016)
APP_PORT=3016

# URL base del motor Ollama interno (Docker/Local)
# Docker:   http://mcp-ollama-motor:11434  (ó http://ollama:11434)
# Local:    http://127.0.0.1:11434
OLLAMA_URL=http://ollama:11434

# Timeout para peticiones a Ollama (milisegundos, default: 300000)
# OLLAMA_TIMEOUT=300000

# Nivel de log (debug | info | warn | error)
# LOG_LEVEL=debug

# Entorno (development | production)
# NODE_ENV=development

# Nombre del contenedor ngrok (para control desde el Dashboard)
# NGROK_CONTAINER_NAME=mcp-ngrok-tunnel

# Nombre del contenedor del Cerebro MCP (para control desde el Dashboard)
# BRAIN_CONTAINER_NAME=brain

# Token de ngrok (obligatorio si querés túneles externos)
# NGROK_AUTHTOKEN=tu_token_aqui

# Modelos a descargar automáticamente al arrancar (separados por coma)
# OLLAMA_AUTO_PULL=llama3.2:3b,qwen2.5-coder:7b
