# ═══════════════════════════════════════════════
#  LaLlamaOllama — Frontend (Dashboard React)
#  Copia este archivo a `.env` y modifica según tu entorno
# ═══════════════════════════════════════════════

# URL base del API (Backend HTTP)
VITE_API_URL=http://localhost:3016

# URL de Socket.IO para eventos en tiempo real del backend
VITE_SOCKET_URL=http://localhost:3016

# URL HTTP base del Cerebro MCP
VITE_BRAIN_API_URL=http://localhost:3015

# URL HTTP base del Agent Engine; el frontend deriva el WebSocket al puerto +1
VITE_ENGINE_URL=http://localhost:3020
