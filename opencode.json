{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "provider": {
    "lallamaollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LaLlamaOllama Proxy",
      "options": {
        "baseURL": "http://localhost:3016/v1",
        "apiKey": "McPOllama2026-V1-Home"
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary"
    },
    "backend-dev": {
      "mode": "subagent"
    },
    "frontend-dev": {
      "mode": "subagent"
    },
    "docker-ops": {
      "mode": "subagent"
    },
    "documentation": {
      "mode": "subagent"
    },
    "mcp-brain": {
      "mode": "subagent"
    }
  },
  "mcp": {
    "lallamaollama-brain": {
      "type": "remote",
      "url": "http://localhost:3015/sse"
    }
  }
}
