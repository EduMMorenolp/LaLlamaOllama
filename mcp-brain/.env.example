# ═══════════════════════════════════════════════
#  LaLlamaOllama — Cerebro MCP (SQLite + vectores)
#  Copia este archivo a `.env` y modifica según tu entorno
# ═══════════════════════════════════════════════

# Puerto del servidor (default: 3015)
BRAIN_PORT=3015

# URL de Ollama para embeddings y análisis semántico
# Docker: http://ollama:11434
# Local:  http://localhost:11434
OLLAMA_API_URL=http://ollama:11434

# Modelo usado para embeddings y análisis (default: llama3.2:3b)
# OLLAMA_MODEL=llama3.2:3b

# Directorio donde se almacena la base de datos SQLite
# DATA_DIR=./data

# IP del host para la URL SSE en la sincronización MCP
# (útil si el servidor no corre en localhost)
# HOST_IP=localhost

# Ruta absoluta del proyecto en el HOST para Antigravity (Docker stdio)
# Ejemplo: D:/Proyectos/LaLlamaOllama
# HOST_PROJECT_PATH=C:/ruta/a/tu/proyecto

# API Key (solo si habilitás seguridad en el cerebro — descomentar en docker-compose)
# API_KEY=tu-api-key

# Rutas personalizadas para config de cada IDE (solo si usás ubicaciones no estándar)
# CLAUDE_CONFIG_PATH=
# ROOCODE_CONFIG_PATH=
