# ═══════════════════════════════════════════════
#  LaLlamaOllama — Agent Engine (Express + BullMQ)
#  Copia este archivo a `.env` y rellena los valores
# ═══════════════════════════════════════════════

# Puerto (default: 3020)
ENGINE_PORT=3020
HOST=0.0.0.0

# Modelo por defecto para las tareas
DEFAULT_MODEL=llama3.2:3b

# Directorio de trabajo del agente
WORKSPACE_DIR=./workspace

# URL del backend de Ollama (Docker: http://ollama:11434)
BACKEND_URL=http://localhost:11434

# URL del Cerebro MCP
BRAIN_URL=http://localhost:3015

# Nombre del proyecto para aislar memorias en mcp-brain
# Cada proyecto debe tener un nombre único para evitar mezcla de memorias
# BRAIN_PROJECT=AgenteLaLlamaOllama

# URL de Redis (cola de tareas BullMQ)
REDIS_URL=redis://localhost:6379

# API Key para autenticación (requerida)
# Este valor debe coincidir con VITE_API_KEY del frontend
API_KEY=super-secret-mcp-key

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8081

# Ruta de la base de datos SQLite local
# DB_PATH=./agent-engine.db

# ── Telegram ────────────────────────────────────
# Token del bot (obtenelo de @BotFather en Telegram)
# Formato: 1234567890:ABCdefGHIjklmNOPqrSTUvwXYZ
# Dejalo vacío si vas a configurarlo desde el Dashboard
# TELEGRAM_BOT_TOKEN=
#
# Usuarios autorizados (separados por coma, sin @)
# Dejalo vacío si vas a configurarlo desde el Dashboard
# TELEGRAM_ALLOWED_USERS=tu_usuario,otro_usuario
