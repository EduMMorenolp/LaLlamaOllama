# ═══════════════════════════════════════════════
#  LaLlamaOllama — Configuración General
#  Copia este archivo a .env y rellena los valores
# ═══════════════════════════════════════════════

# ── Puertos ─────────────────────────────────────
# Backend principal (Ollama MCP Server + Dashboard API)
APP_PORT=3016

# Cerebro MCP (memoria compartida SQLite + vectores)
BRAIN_PORT=3015

# Agent Engine (agente autónomo + cola BullMQ + Telegram)
ENGINE_PORT=3020

# Redis (cola de tareas del Agent Engine)
# REDIS_PORT=6379

# ── Seguridad ───────────────────────────────────
# API Key — TODOS los servicios la usan para autenticación
API_KEY=mcp_clave_segura_123

# Orígenes permitidos para CORS del Agent Engine (separados por coma)
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ── Ollama ──────────────────────────────────────
# URL interna del motor Ollama (cambia si usás una externa)
OLLAMA_URL=http://ollama:11434

# Timeout para peticiones a Ollama (en milisegundos)
# OLLAMA_TIMEOUT=300000

# Modelo por defecto para el Agent Engine
DEFAULT_MODEL=llama3.2:3b

# Modelo usado por el Cerebro MCP para embeddings y análisis
# OLLAMA_MODEL=llama3.2:3b

# Modelos a descargar automáticamente al arrancar (separados por coma, sin espacios)
# Deja vacío para desactivar. Los modelos ya descargados se omiten.
# Recomendados:
#   - gemma4:e2b         → excelente siguiendo instrucciones y Tool Calling
#   - qwen2.5-coder:7b   → asígnalo a sub-agentes de desarrollo
#   - llama3.2:3b        → chat general del día a día (rápido)
#   - deepseek-r1:8b     → bugs difíciles o planificación de arquitectura
# OLLAMA_AUTO_PULL=llama3.2:3b,qwen2.5-coder:7b,deepseek-r1:8b,gemma4:e2b

# ── Agent Engine ────────────────────────────────
# URL del Backend (para que el Agent Engine se comunique)
BACKEND_URL=http://backend:3016

# URL del Cerebro MCP
BRAIN_URL=http://brain:3015

# URL de Redis (cola de tareas)
REDIS_URL=redis://redis:6379

# Directorio de trabajo del Agent Engine (dentro del contenedor)
# WORKSPACE_DIR=/workspace

# Ruta de la base de datos SQLite del Agent Engine
# DB_PATH=/data/agent-engine.db

# ── Telegram ────────────────────────────────────
# Token del bot de Telegram (obtenelo de @BotFather en Telegram)
# Formato: 1234567890:ABCdefGHIjklmNOPqrSTUvwXYZ
# Dejalo vacío si vas a configurarlo desde el Dashboard (Conexión → Telegram)
# TELEGRAM_BOT_TOKEN=

# Usuarios de Telegram autorizados a usar el bot (separados por coma, sin @)
# Dejalo vacío si vas a configurarlo desde el Dashboard
# TELEGRAM_ALLOWED_USERS=tu_usuario,otro_usuario

# ── Ngrok ───────────────────────────────────────
# Token de autenticación de ngrok (Obtenlo en dashboard.ngrok.com)
NGROK_AUTHTOKEN=tu_token_aqui

# Nombre del contenedor ngrok (solo si lo cambiaste en docker-compose)
# NGROK_CONTAINER_NAME=mcp-ngrok-tunnel

# ── Docker ──────────────────────────────────────
# Nombre del contenedor del Cerebro MCP
# BRAIN_CONTAINER_NAME=brain

# Habilita detección de GPU NVIDIA (docker-compose lo maneja automáticamente)
# NVIDIA_VISIBLE_DEVICES=all

# ── Cerebro MCP (mcp-brain) ─────────────────────
# IP del host para la sincronización SSE (útil si no es localhost)
# HOST_IP=localhost

# Ruta absoluta del proyecto en el HOST (Windows) para Antigravity
# Ejemplo: D:/Proyectos/LaLlamaOllama
# HOST_PROJECT_PATH=C:/ruta/a/tu/proyecto

# Directorio de datos del Cerebro MCP (SQLite)
# DATA_DIR=./data

# Rutas personalizadas para archivos de configuración MCP de cada IDE
# (solo si usás ubicaciones no estándar)
# CLAUDE_CONFIG_PATH=
# ROOCODE_CONFIG_PATH=

# ── Backend ─────────────────────────────────────
# Nivel de log (debug | info | warn | error)
# LOG_LEVEL=debug

# Entorno (development | production)
# NODE_ENV=development
