# ═══════════════════════════════════════════════
#  LaLlamaOllama — Configuración General
#  Copia este archivo a .env y rellena los valores
# ═══════════════════════════════════════════════

# ── Backend ─────────────────────────────────────
# Nivel de log (debug | info | warn | error)
LOG_LEVEL=debug
NODE_ENV=development

# ── Puertos ─────────────────────────────────────
APP_PORT=3016
BRAIN_PORT=3015
ENGINE_PORT=3020
# REDIS_PORT=6379

# ── Seguridad ───────────────────────────────────
API_KEY=mcp_clave_segura_123
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ── Ollama ──────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# URL de Ollama usada por el Cerebro MCP
OLLAMA_API_URL=http://ollama:11434
# OLLAMA_TIMEOUT=300000

# Modelo por defecto para el Agent Engine
DEFAULT_MODEL=llama3.2:3b
# LLM_TIMEOUT=600000

# Modelo usado por el Cerebro MCP para embeddings y análisis
# OLLAMA_MODEL=llama3.2:3b

# Modelos a descargar automáticamente al arrancar
# OLLAMA_AUTO_PULL=llama3.2:3b,qwen2.5-coder:7b,deepseek-r1:8b,gemma4:e2b

# ── Agent Engine ────────────────────────────────
# URL del Backend (para que el Agent Engine se comunique)
BACKEND_URL=http://backend:3016

# URL del Cerebro MCP
BRAIN_URL=http://brain:3015
# Directorio de datos del Cerebro MCP (SQLite)
# DATA_DIR=./data

# Variables útiles para la sincronización MCP desde el Cerebro
# HOST_IP=localhost
# HOST_PROJECT_PATH=C:/ruta/a/tu/proyecto
# CLAUDE_CONFIG_PATH=
# ROOCODE_CONFIG_PATH=

# URL de Redis (cola de tareas)
REDIS_URL=redis://redis:6379

# Directorio de trabajo del Agent Engine (dentro del contenedor)
# WORKSPACE_DIR=/workspace

# Ruta de la base de datos SQLite del Agent Engine
# DB_PATH=/data/agent-engine.db

# ── Telegram ────────────────────────────────────
# Dejalo vacío si vas a configurarlo desde el Dashboard (Conexión → Telegram)
TELEGRAM_BOT_TOKEN=
# Usuarios de Telegram autorizados a usar el bot (separados por coma, sin @)
TELEGRAM_ALLOWED_USERS=

# ── Ngrok ───────────────────────────────────────
NGROK_AUTHTOKEN=tu_token_aqui